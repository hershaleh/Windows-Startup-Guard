<Window x:Class="WindowsStartupGuard.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:nav="clr-namespace:System.Windows.Navigation;assembly=PresentationFramework"
 Title="Windows Startup Guard" Width="1380" Height="900" MinWidth="1080" MinHeight="720"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBg}" FontFamily="Segoe UI"
 FlowDirection="RightToLeft" Loaded="Window_Loaded">
 <Window.Resources>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="17,10"/>
  </Style>
  <Style x:Key="SidebarButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#DCE6FA"/>
   <Setter Property="HorizontalContentAlignment" Value="Right"/><Setter Property="Margin" Value="0,4"/>
   <Setter Property="Padding" Value="16,14"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#263B62"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value=".7"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DashboardCard" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource PanelBg}"/><Setter Property="CornerRadius" Value="16"/>
   <Setter Property="Padding" Value="20"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Opacity" Value="0"/>
   <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="18"/></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid x:Name="Root" Opacity="0">
  <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="{DynamicResource SidebarBg}" Padding="20">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="0,5,0,34">
      <Border Width="43" Height="43" CornerRadius="13" Background="#4778F5" Margin="0,0,12,0">
       <TextBlock Text="✓" FontSize="27" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="STARTUP" Foreground="White" FontSize="16" FontWeight="Bold"/><TextBlock Text="GUARD" Foreground="#8FA8D9" FontSize="11" FontWeight="SemiBold"/></StackPanel>
     </StackPanel>
     <TextBlock Text="תפריט ראשי" Foreground="#8294B8" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,12"/>
     <Button x:Name="DashboardNav" Style="{StaticResource SidebarButton}" Content="▦   לוח בקרה" Click="Dashboard_Click"/>
     <Button x:Name="StartupNav" Style="{StaticResource SidebarButton}" Content="◉   תוכנות אתחול" Click="Startup_Click"/>
     <Button Style="{StaticResource SidebarButton}" Content="↶   גיבויים ושחזור" Click="RestoreAll_Click"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <Border Background="#1B2A4A" CornerRadius="14" Padding="13" Margin="0,0,0,15">
      <StackPanel><TextBlock Text="הגנה בטוחה" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="כל שינוי ניתן לשחזור מגיבוי" Foreground="#A8B8D7" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
     </Border>
     <Border Background="#1B2A4A" CornerRadius="14" Padding="9" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal">
       <Ellipse x:Name="CreditAvatar" Width="42" Height="42" Fill="#4778F5" Margin="0,0,10,0"/>
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="נוצר על ידי" Foreground="#A8B8D7" FontSize="10"/>
        <TextBlock Foreground="White" FontWeight="Bold" FontSize="13">
         <Hyperlink NavigateUri="https://mitmachim.top/user/%D7%94%D7%A2%D7%A8%D7%A9%D7%9C%D7%94" RequestNavigate="CreditLink_RequestNavigate" Foreground="#9BB9FF">הערשלה</Hyperlink>
        </TextBlock>
       </StackPanel>
      </StackPanel>
     </Border>
     <TextBlock Text="Windows Startup Guard" Foreground="#7187AD" FontSize="10" HorizontalAlignment="Center"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <ScrollViewer x:Name="ContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid Margin="30,24,30,28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,24">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0" VerticalAlignment="Center">
      <TextBlock x:Name="Greeting" Text="שלום וברוכים הבאים" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
      <TextBlock x:Name="Subtitle" Text="ניהול פשוט ובטוח של התוכנות שעולות עם Windows" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,5,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="18,0,0,0">
      <Button x:Name="LanguageButton" Content="עברית / EN" Click="Language_Click" Margin="0,0,7,0"/>
      <Button x:Name="ThemeButton" Content="☾  מצב כהה" Click="Theme_Click" Margin="0,0,7,0"/>
      <Button x:Name="GuideButton" Content="מדריך" Click="Guide_Click" Margin="0,0,7,0"/>
      <Button x:Name="ReportButton" Content="דיווח תקלה" Click="Report_Click"/>
     </StackPanel>
    </Grid>
    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,22">
     <Border x:Name="CardItems" Style="{StaticResource DashboardCard}" Margin="0,0,12,0">
      <StackPanel><TextBlock x:Name="ItemsHeading" Text="פריטי אתחול" Foreground="{DynamicResource TextMuted}" FontSize="12"/><TextBlock x:Name="ItemsCount" Text="—" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextMain}" Margin="0,7,0,0"/><TextBlock Text="תוכנות שנסרקו" Foreground="{DynamicResource TextMuted}" FontSize="11"/></StackPanel>
     </Border>
     <Border x:Name="CardBackups" Style="{StaticResource DashboardCard}" Margin="6,0">
      <StackPanel><TextBlock Text="גיבויים זמינים" Foreground="{DynamicResource TextMuted}" FontSize="12"/><TextBlock x:Name="BackupCount" Text="—" FontSize="32" FontWeight="Bold" Foreground="#4778F5" Margin="0,7,0,0"/><TextBlock Text="ניתנים לשחזור" Foreground="{DynamicResource TextMuted}" FontSize="11"/></StackPanel>
     </Border>
     <Border x:Name="CardProtection" Style="{StaticResource DashboardCard}" Margin="12,0,0,0">
      <StackPanel><TextBlock Text="מצב הגנה" Foreground="{DynamicResource TextMuted}" FontSize="12"/><TextBlock Text="פעיל" FontSize="32" FontWeight="Bold" Foreground="#16A477" Margin="0,7,0,0"/><TextBlock Text="גיבוי לפני כל נטרול" Foreground="{DynamicResource TextMuted}" FontSize="11"/></StackPanel>
     </Border>
    </UniformGrid>
    <Grid x:Name="InventoryToolbar" Grid.Row="2" Margin="0,0,0,14">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock x:Name="SectionHeading" Text="תוכנות אתחול" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/><TextBlock x:Name="SectionSubtitle" Text="בדוק מה מופעל, נטרל פריטים מיותרים ושחזר בכל עת" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
      <Border Background="{DynamicResource ControlBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="11" Height="40" Width="225" Margin="0,0,8,0">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⌕" FontSize="21" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextMain}" VerticalContentAlignment="Center" Padding="3,0,10,0" ToolTip="חיפוש לפי שם, מפרסם או נתיב" TextChanged="SearchBox_TextChanged"/></Grid>
      </Border>
      <ComboBox x:Name="ScopeFilter" Width="145" Height="40" Margin="0,0,8,0" SelectedIndex="0" SelectionChanged="ScopeFilter_SelectionChanged" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextMain}">
       <ComboBoxItem Content="כל המשתמשים"/><ComboBoxItem Content="המשתמש הנוכחי"/>
      </ComboBox>
      <Button x:Name="RefreshButton" Content="↻  רענון" Click="Refresh_Click" Style="{StaticResource PrimaryButton}"/>
     </StackPanel>
    </Grid>
    <Border x:Name="DashboardDetails" Grid.Row="2" Grid.RowSpan="3" Visibility="Collapsed" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="18" Padding="28" Margin="0,0,0,10">
     <StackPanel>
      <TextBlock Text="סקירה כללית" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
      <TextBlock Text="כל מה שחשוב לדעת על תוכנות האתחול שלך, במקום אחד." FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,24"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Grid.Column="0" Background="{DynamicResource GridAltBg}" CornerRadius="14" Padding="20" Margin="0,0,8,0">
        <StackPanel><TextBlock Text="מה אפשר לעשות כאן?" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
         <TextBlock Text="• לצפות בכל התוכנות שעולות עם Windows&#10;• לחפש לפי שם, מפרסם או נתיב&#10;• לנטרל פריטים לא נחוצים ולשמור גיבוי&#10;• לשחזר פריטים שנוטרלו בעבר" FontSize="13" LineHeight="27" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,12,0,0"/>
        </StackPanel>
       </Border>
       <Border Grid.Column="1" Background="{DynamicResource GridAltBg}" CornerRadius="14" Padding="20" Margin="8,0,0,0">
        <StackPanel><TextBlock Text="המלצות לשימוש בטוח" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
         <TextBlock Text="• אל תנטרל פריט שאינך מזהה לפני שבדקת אותו.&#10;• שינויי אתחול נשמרים בגיבוי מקומי.&#10;• פריטים של כלל המשתמשים עשויים לדרוש הרשאות מנהל.&#10;• ניתן לחזור בכל עת למסך תוכנות האתחול." FontSize="13" LineHeight="27" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,12,0,0"/>
        </StackPanel>
       </Border>
      </Grid>
      <Button x:Name="GoToStartupButton" Content="מעבר לניהול תוכנות אתחול  ←" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,24,0,0" Click="Startup_Click"/>
     </StackPanel>
    </Border>
    <Border x:Name="InventoryPanel" Grid.Row="3" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="8" MinHeight="430">
     <DataGrid x:Name="StartupGrid" SelectionMode="Extended" SelectionUnit="FullRow" AlternationCount="2" CanUserResizeRows="False">
      <DataGrid.Columns>
       <DataGridTextColumn Header="שם התוכנה" Binding="{Binding Name}" Width="1.35*"/>
       <DataGridTextColumn Header="מפרסם" Binding="{Binding Publisher}" Width="1.1*"/>
       <DataGridTextColumn Header="מצב" Binding="{Binding Status}" Width="0.75*"/>
       <DataGridTextColumn Header="מקור" Binding="{Binding Source}" Width="0.85*"/>
       <DataGridTextColumn Header="היקף" Binding="{Binding Scope}" Width="0.85*"/>
       <DataGridTextColumn Header="גרסה" Binding="{Binding Version}" Width="0.8*"/>
       <DataGridTextColumn Header="נתיב הפעלה" Binding="{Binding Path}" Width="2*"/>
      </DataGrid.Columns>
     </DataGrid>
    </Border>
    <Grid x:Name="ActionsPanel" Grid.Row="4" Margin="0,16,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Grid.Column="0" x:Name="StatusText" Text="מוכן" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
      <Button x:Name="DisableButton" Content="נטרול נבחרים" Style="{StaticResource PrimaryButton}" Click="Disable_Click" Margin="0,0,8,0"/>
      <Button x:Name="StopButton" Content="סגירת תהליך" Click="Stop_Click" Margin="0,0,8,0"/>
      <Button x:Name="RestoreSelectedButton" Content="שחזור נבחרים" Click="RestoreSelected_Click" Margin="0,0,8,0"/>
      <Button x:Name="RestoreAllButton" Content="שחזור הכול" Click="RestoreAll_Click" Margin="0,0,8,0"/>
      <Button x:Name="ExportButton" Content="ייצוא CSV" Click="Export_Click"/>
     </StackPanel>
    </Grid>
   </Grid>
  </ScrollViewer>
 </Grid>
</Window>