<Window x:Class="WindowsStartupGuard.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Windows Startup Guard" Width="1380" Height="860" MinWidth="1080" MinHeight="700"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBg}" FontFamily="Segoe UI"
 FlowDirection="RightToLeft" Loaded="Window_Loaded">
 <Window.Resources>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#1B2A4A"/><Setter Property="Foreground" Value="#E8EEFC"/>
   <Setter Property="HorizontalContentAlignment" Value="Right"/><Setter Property="Margin" Value="0,5"/>
   <Setter Property="Padding" Value="16,13"/>
  </Style>
 </Window.Resources>
 <Grid x:Name="Root" Opacity="0">
  <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="{DynamicResource SidebarBg}" Padding="22">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="0,5,0,34">
      <Border Width="42" Height="42" CornerRadius="13" Background="#4778F5" Margin="0,0,12,0">
       <TextBlock Text="✓" FontSize="27" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="STARTUP" Foreground="White" FontSize="16" FontWeight="Bold"/><TextBlock Text="GUARD" Foreground="#8FA8D9" FontSize="11" FontWeight="SemiBold" CharacterSpacing="180"/></StackPanel>
     </StackPanel>
     <TextBlock Text="תפריט ראשי" Foreground="#8294B8" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,12"/>
     <Button Style="{StaticResource SidebarButton}" Content="▦   לוח בקרה" />
     <Button Style="{StaticResource SidebarButton}" Content="◉   תוכנות אתחול" />
     <Button Style="{StaticResource SidebarButton}" Content="↶   גיבויים ושחזור" Click="RestoreAll_Click"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <Border Background="#1B2A4A" CornerRadius="14" Padding="13" Margin="0,0,0,15">
      <StackPanel><TextBlock Text="הגנה בטוחה" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="כל שינוי ניתן לשחזור מגיבוי" Foreground="#A8B8D7" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
     </Border>
     <TextBlock Text="נוצר על ידי הערשלה" Foreground="#A8B8D7" FontSize="11" HorizontalAlignment="Center"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,24,30,24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="0,0,0,24">
    <StackPanel><TextBlock x:Name="Greeting" Text="שלום וברוכים הבאים" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/><TextBlock Text="ניהול פשוט ובטוח של התוכנות שעולות עם Windows" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,5,0,0"/></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
     <Button x:Name="ThemeButton" Content="☾  מצב כהה" Click="Theme_Click" Margin="0,0,8,0"/>
     <Button Content="מדריך" Click="Guide_Click" Margin="0,0,8,0"/>
     <Button Content="דיווח תקלה" Click="Report_Click"/>
    </StackPanel>
   </Grid>
   <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,22">
    <Border Background="{DynamicResource PanelBg}" CornerRadius="16" Padding="20" Margin="0,0,12,0">
     <StackPanel><TextBlock Text="פריטי אתחול" Foreground="{DynamicResource TextMuted}" FontSize="12"/><TextBlock x:Name="ItemsCount" Text="—" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextMain}" Margin="0,7,0,0"/><TextBlock Text="תוכנות שנסרקו" Foreground="{DynamicResource TextMuted}" FontSize="11"/></StackPanel>
    </Border>
    <Border Background="{DynamicResource PanelBg}" CornerRadius="16" Padding="20" Margin="6,0">
     <StackPanel><TextBlock Text="גיבויים זמינים" Foreground="{DynamicResource TextMuted}" FontSize="12"/><TextBlock x:Name="BackupCount" Text="—" FontSize="32" FontWeight="Bold" Foreground="#4778F5" Margin="0,7,0,0"/><TextBlock Text="ניתנים לשחזור" Foreground="{DynamicResource TextMuted}" FontSize="11"/></StackPanel>
    </Border>
    <Border Background="{DynamicResource PanelBg}" CornerRadius="16" Padding="20" Margin="12,0,0,0">
     <StackPanel><TextBlock Text="מצב הגנה" Foreground="{DynamicResource TextMuted}" FontSize="12"/><TextBlock Text="פעיל" FontSize="32" FontWeight="Bold" Foreground="#16A477" Margin="0,7,0,0"/><TextBlock Text="גיבוי לפני כל נטרול" Foreground="{DynamicResource TextMuted}" FontSize="11"/></StackPanel>
    </Border>
   </UniformGrid>
   <Grid Grid.Row="2" Margin="0,0,0,14">
    <StackPanel><TextBlock Text="תוכנות אתחול" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/><TextBlock Text="בדוק מה מופעל, נטרל פריטים מיותרים ושחזר בכל עת" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
     <TextBox x:Name="SearchBox" Width="210" Height="38" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="{DynamicResource Line}" TextChanged="SearchBox_TextChanged"/>
     <ComboBox x:Name="ScopeFilter" Width="130" Height="38" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="ScopeFilter_SelectionChanged">
      <ComboBoxItem Content="כל המשתמשים"/><ComboBoxItem Content="המשתמש הנוכחי"/>
     </ComboBox>
     <Button Content="רענון" Click="Refresh_Click" Margin="8,0,0,0"/>
    </StackPanel>
   </Grid>
   <Border Grid.Row="3" Background="{DynamicResource PanelBg}" CornerRadius="16" Padding="8">
    <DataGrid x:Name="StartupGrid" SelectionMode="Extended" SelectionUnit="FullRow" AlternationCount="2" CanUserResizeRows="False">
     <DataGrid.Columns>
      <DataGridTextColumn Header="שם התוכנה" Binding="{Binding Name}" Width="1.35*"/>
      <DataGridTextColumn Header="מפרסם" Binding="{Binding Publisher}" Width="1.1*"/>
      <DataGridTextColumn Header="מצב" Binding="{Binding Status}" Width="0.75*"/>
      <DataGridTextColumn Header="מקור" Binding="{Binding Source}" Width="0.85*"/>
      <DataGridTextColumn Header="היקף" Binding="{Binding Scope}" Width="0.85*"/>
      <DataGridTextColumn Header="גרסה" Binding="{Binding Version}" Width="0.8*"/>
      <DataGridTextColumn Header="נתיב הפעלה" Binding="{Binding Path}" Width="2*"/>
     </DataGrid.Columns>
    </DataGrid>
   </Border>
   <Grid Grid.Row="4" Margin="0,16,0,0">
    <TextBlock x:Name="StatusText" Text="מוכן" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
     <Button Content="נטרול נבחרים" Style="{StaticResource PrimaryButton}" Click="Disable_Click" Margin="0,0,8,0"/>
     <Button Content="סגירת תהליך" Click="Stop_Click" Margin="0,0,8,0"/>
     <Button Content="שחזור נבחרים" Click="RestoreSelected_Click" Margin="0,0,8,0"/>
     <Button Content="שחזור הכול" Click="RestoreAll_Click" Margin="0,0,8,0"/>
     <Button Content="ייצוא CSV" Click="Export_Click"/>
    </StackPanel>
   </Grid>
  </Grid>
 </Grid>
</Window>