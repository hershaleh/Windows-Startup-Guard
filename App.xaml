<Application x:Class="WindowsStartupGuard.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="AppBg" Color="#F3F6FC"/>
  <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SidebarBg" Color="#101B35"/>
  <SolidColorBrush x:Key="TextMain" Color="#18243B"/>
  <SolidColorBrush x:Key="TextMuted" Color="#77849A"/>
  <SolidColorBrush x:Key="Accent" Color="#4778F5"/>
  <SolidColorBrush x:Key="Line" Color="#E6EBF3"/>
  <SolidColorBrush x:Key="SoftBlue" Color="#EAF0FF"/>
  <Style TargetType="Button">
   <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Padding" Value="16,10"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="{DynamicResource PanelBg}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value=".82"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value=".68"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value=".4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="Background" Value="{DynamicResource PanelBg}"/><Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Line}"/><Setter Property="RowHeaderWidth" Value="0"/>
   <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
   <Setter Property="RowHeight" Value="48"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="AlternatingRowBackground" Value="#F8FAFD"/>
   <Setter Property="ColumnHeaderHeight" Value="44"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="#F5F7FB"/><Setter Property="Foreground" Value="#68758B"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Padding" Value="12,0"/>
  </Style>
 </Application.Resources>
</Application>