<Application x:Class="WindowsStartupGuard.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="AppBg" Color="#F3F6FC"/>
  <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SidebarBg" Color="#101B35"/>
  <SolidColorBrush x:Key="TextMain" Color="#18243B"/>
  <SolidColorBrush x:Key="TextMuted" Color="#77849A"/>
  <SolidColorBrush x:Key="Accent" Color="#4778F5"/>
  <SolidColorBrush x:Key="Line" Color="#E6EBF3"/>
  <SolidColorBrush x:Key="SoftBlue" Color="#EAF0FF"/>
  <SolidColorBrush x:Key="ControlBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="GridHeaderBg" Color="#F5F7FB"/>
  <SolidColorBrush x:Key="GridAltBg" Color="#F8FAFD"/>
  <SolidColorBrush x:Key="GridSelectionBg" Color="#DCE8FF"/>
  <Style TargetType="Button">
   <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Padding" Value="15,9"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="{DynamicResource PanelBg}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value=".82"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value=".68"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value=".4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,5"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="Background" Value="{DynamicResource PanelBg}"/><Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Line}"/><Setter Property="RowHeaderWidth" Value="0"/>
   <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
   <Setter Property="RowHeight" Value="48"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="AlternatingRowBackground" Value="{DynamicResource GridAltBg}"/>
   <Setter Property="ColumnHeaderHeight" Value="44"/>
   <Setter Property="RowStyle"><Setter.Value><Style TargetType="DataGridRow">
    <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Style.Triggers>
     <Trigger Property="ItemsControl.AlternationIndex" Value="1"><Setter Property="Background" Value="{DynamicResource GridAltBg}"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SoftBlue}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource GridSelectionBg}"/><Setter Property="Foreground" Value="{DynamicResource TextMain}"/></Trigger>
    </Style.Triggers>
   </Style></Setter.Value></Setter>
   <Setter Property="CellStyle"><Setter.Value><Style TargetType="DataGridCell">
    <Setter Property="Foreground" Value="{DynamicResource TextMain}"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="8,0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextMain}"/><Setter Property="Background" Value="{DynamicResource GridSelectionBg}"/></Trigger></Style.Triggers>
   </Style></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="{DynamicResource GridHeaderBg}"/><Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Padding" Value="12,0"/>
  </Style>
 </Application.Resources>
</Application>