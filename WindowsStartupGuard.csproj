<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WindowsStartupGuard.ico</ApplicationIcon>
    <AssemblyName>WindowsStartupGuard</AssemblyName>
    <RootNamespace>WindowsStartupGuard</RootNamespace>
    <Version>0.2.2</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\hershaleh.jpg" />
  </ItemGroup>
  <Target Name="GenerateApplicationIcon" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\GenerateIcon.ps1&quot;" />
  </Target>
</Project>
