<Window x:Class="WindowsStartupGuard.SplashWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="620" Height="390" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
 AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Loaded="Window_Loaded">
 <Window.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
  <DoubleAnimation Storyboard.TargetName="Logo" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.7"/>
  <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleX" From=".55" To="1" Duration="0:0:0.8"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
  <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleY" From=".55" To="1" Duration="0:0:0.8"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
  <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" From="0" To=".65" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever"/>
  <DoubleAnimation Storyboard.TargetName="Loading" Storyboard.TargetProperty="Width" From="10" To="430" Duration="0:0:1.7"/>
  <DoubleAnimation Storyboard.TargetName="TitleText" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.35" Duration="0:0:0.65"/>
  <DoubleAnimation Storyboard.TargetName="Subtitle" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.65" Duration="0:0:0.65"/>
 </Storyboard></BeginStoryboard></EventTrigger></Window.Triggers>
 <Border CornerRadius="26" ClipToBounds="True" BorderBrush="#638CCB" BorderThickness="1">
  <Grid Background="#0E1B38">
   <Ellipse x:Name="Glow" Width="370" Height="370" Fill="#294D9B" Opacity="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-160,-100,0"/>
   <Ellipse Width="250" Height="250" Fill="#172F60" Opacity=".5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-100,0,0,-100"/>
   <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
    <Grid Width="118" Height="118" Margin="0,0,0,20">
     <Ellipse Fill="#284E9D" Opacity=".55"/>
     <Border x:Name="Logo" Width="96" Height="96" CornerRadius="27" Background="#4778F5" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border.RenderTransform><ScaleTransform x:Name="LogoScale" ScaleX=".55" ScaleY=".55"/></Border.RenderTransform>
      <TextBlock Text="✓" FontSize="64" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
    </Grid>
    <TextBlock x:Name="TitleText" Text="Windows Startup Guard" FontSize="29" FontWeight="Bold" Foreground="White" Opacity="0" HorizontalAlignment="Center"/>
    <TextBlock x:Name="Subtitle" Text="שליטה בטוחה. הפעלה חכמה. שקט נפשי." FontSize="15" Foreground="#B7C9EB" Opacity="0" Margin="0,12,0,30" HorizontalAlignment="Center"/>
    <Border Width="430" Height="5" Background="#33476D" CornerRadius="3"><Border x:Name="Loading" Width="10" HorizontalAlignment="Right" Background="#75A2FF" CornerRadius="3"/></Border>
    <TextBlock Text="מכין את סביבת העבודה..." Foreground="#8096BD" FontSize="11" Margin="0,12,0,0" HorizontalAlignment="Center"/>
   </StackPanel>
  </Grid>
 </Border>
</Window>